# Hermes Stack — environment variables
# This file is rendered into ~/.hermes/.env by the setup wizard.
# Keep it private: it has 0600 permissions by default.

# ---------- LLM Providers ----------
# Primary gateway: https://openrouter.ai/keys
OPENROUTER_API_KEY=$OPENROUTER_API_KEY

# Fallback provider: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY

# ---------- Chat Platforms ----------
# Only one of the following needs a real value; leave the others as placeholders.
DISCORD_BOT_TOKEN=$DISCORD_BOT_TOKEN
SLACK_WEBHOOK_URL=$SLACK_WEBHOOK_URL
TELEGRAM_BOT_TOKEN=$TELEGRAM_BOT_TOKEN

# ---------- Google Workspace ----------
# Used by the Gmail / Calendar / Drive MCP servers for OAuth association.
GOOGLE_WORKSPACE_EMAIL=$GOOGLE_WORKSPACE_EMAIL

# ---------- n8n (optional automation) ----------
N8N_BASE_URL=$N8N_BASE_URL
N8N_API_KEY=$N8N_API_KEY

# ---------- Obsidian Knowledge Vault ----------
# Path to your Obsidian vault — your persistent, unlimited memory.
# Your AI reads this at session start and writes Journal entries after sessions.
# Default: ~/Knowledge Vault (the installer scaffolds it for you)
OBSIDIAN_VAULT_PATH=$OBSIDIAN_VAULT_PATH

# ---------- Coding Agent ----------
# Which coding agent to wire into the stack.
# Options: claude (Claude Code), codex (OpenAI Codex CLI), cursor (Cursor IDE), none
CODING_AGENT=$CODING_AGENT
